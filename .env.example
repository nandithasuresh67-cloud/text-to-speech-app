# Backend configuration
FRONTEND_ORIGIN=http://localhost:5173
MAX_TEXT_LENGTH=1000

# Rate limiting
# For local development, leave blank to use in-memory storage.
# For production, point to a Redis instance, for example:
# REDIS_URL=redis://:password@localhost:6379/0
REDIS_URL=
RATE_LIMIT_DEFAULT=60 per minute

# How long generated audio files are kept before automatic cleanup (seconds)
AUDIO_MAX_AGE_SECONDS=3600

# Database (SQLite by default; use a Postgres URL in production, e.g.
# postgresql://user:password@host:5432/dbname)
DATABASE_URL=sqlite:///tts_app.db

# JWT auth (must be a long random secret in production)
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Level 3 - Usage Limits: max speech generations per logged-in user per day
DAILY_GENERATION_LIMIT=50

# Level 3 - AI Text Enhancement provider. "rule_based" (default) needs no
# API key. Set to "llm" once you've wired a real provider into
# services/enhancement_service.py's _enhance_with_llm().
ENHANCEMENT_PROVIDER=rule_based

# Placeholders for a future cloud TTS provider (Google/Azure/Polly/ElevenLabs).
# Not required for the default gTTS-based implementation.
TTS_API_KEY=
TTS_REGION=
TTS_ENDPOINT=
